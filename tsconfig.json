{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"baseUrl": ".",
		"resolveJsonModule": true,
		"paths": {
			"@/*": [
				"src/*"
			]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "react"
	},
	"include": [
		"src/**/*",
		"scripts/**/*",
		"./worker-configuration.d.ts"
	],
	"exclude": [
		"node_modules",
		"dist",
		"src/app"
	]
}