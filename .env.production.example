# WordPress GraphQL Endpoint
WPGRAPHQL_ENDPOINT=https://cms.webuy.in.th/webuy/graphql

# เพิ่มเลขทุกครั้งที่ต้องการล้าง Next unstable_cache ของ WP (เช่น แคชว่างค้างบน Coolify)
# WP_CACHE_REVISION=2

# ห้ามเปิดใน production ถ้าไม่ได้ debug — จะได้ข้อมูลว่างแทน error
# WP_FALLBACK_ON_ERROR=0

# Site URL (PRODUCTION - เปลี่ยนเป็น domain จริง!)
SITE_URL=https://YOUR-DOMAIN.com

# Site Key
SITE_KEY=webuy

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
