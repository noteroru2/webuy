# WordPress GraphQL Endpoint (ใช้ตอน npm run sync:wp เท่านั้น)
WPGRAPHQL_ENDPOINT=https://cms.webuy.in.th/webuy/graphql

# Secret สำหรับ GraphQL (ถ้า CMS เปิดใช้)
# WEBUY_GQL_SECRET=
# WEBUY_GQL_SEND_SECRET=1

# หน่วงระหว่าง request ตอน sync (ms)
# WP_REQUEST_DELAY_MS=400

# --- Offline build (หลัง sync แล้ว commit wp-data ลง repo) ---
# WP_OFFLINE=1          # บังคับใช้ไฟล์ local เท่านั้น (npm run build:offline)
# WP_USE_LOCAL=1        # เหมือนกัน แต่ fallback ได้ถ้าไม่มีไฟล์

# จำกัดจำนวนหน้าตอน dev/build เร็ว
# FAST_BUILD_LIMIT=5

# Site URL (PRODUCTION - เปลี่ยนเป็น domain จริง!)
SITE_URL=https://YOUR-DOMAIN.com

# Site Key
SITE_KEY=webuy

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
