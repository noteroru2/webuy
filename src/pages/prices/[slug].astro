---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PriceView } from "../../components/pages/PriceView";
import { buildPricePageModel } from "../../lib/build-price-page";
import type { PricePageModel } from "../../lib/build-price-page";
import { getAllPriceSlugs } from "../../lib/wp-build";

export async function getStaticPaths() {
  const slugsAll = await getAllPriceSlugs();
  const limit = Number(process.env.FAST_BUILD_LIMIT || "0") || 0;
  const slugs = limit > 0 ? slugsAll.slice(0, limit) : slugsAll;
  const out: { params: { slug: string }; props: { model: PricePageModel } }[] = [];
  for (const slug of slugs) {
    const model = await buildPricePageModel(slug);
    if (model) out.push({ params: { slug }, props: { model } });
  }
  return out;
}

const { model } = Astro.props as { model: PricePageModel };
---

<BaseLayout title={model.title} description={model.description}>
  <PriceView {...model} />
</BaseLayout>
