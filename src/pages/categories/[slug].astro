---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CategoryView } from "../../components/pages/CategoryView";
import { buildCategoryPageModel } from "../../lib/build-category-page";
import type { CategoryPageModel } from "../../lib/build-category-page";
import { getAllCategorySlugs } from "../../lib/wp-build";

export async function getStaticPaths() {
  const slugsAll = await getAllCategorySlugs();
  const limit = Number(process.env.FAST_BUILD_LIMIT || "0") || 0;
  const slugs = limit > 0 ? slugsAll.slice(0, limit) : slugsAll;
  const out: { params: { slug: string }; props: { model: CategoryPageModel } }[] = [];
  for (const slug of slugs) {
    const model = await buildCategoryPageModel(slug);
    if (model) out.push({ params: { slug }, props: { model } });
  }
  return out;
}

const { model } = Astro.props as { model: CategoryPageModel };
---

<BaseLayout title={model.title} description={model.description}>
  <CategoryView {...model} />
</BaseLayout>
