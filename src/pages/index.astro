---
import BaseLayout from "../layouts/BaseLayout.astro";
import { HomePage } from "../components/pages/HomePage";
import { getHubIndex, getSiteSettings } from "../lib/content";

const hub = await getHubIndex();
const hubFetchFailed = hub === null;
const sitePage = await getSiteSettings();
const title = "WEBUY HUB ในเครือ AMPHON | ส่งรูปประเมินโน๊ตบุ๊ค MacBook PC";
const description =
  "WEBUY HUB ช่องทางรับข้อมูลสินค้าไอทีมือสองในเครือ AMPHON TRADING ส่งรูปและสเปกประเมินเบื้องต้น LINE @webuy มีหน้าร้านจริงที่อุบลราชธานี การนัดรับหรือจัดส่งและชำระเงินยืนยันตามข้อตกลงหลังตรวจเครื่อง";
---

<BaseLayout title={title} description={description}>
  <HomePage hub={hub} hubFetchFailed={hubFetchFailed} sitePage={sitePage} />
</BaseLayout>
