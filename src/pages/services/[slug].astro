---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ServiceView } from "../../components/pages/ServiceView";
import { buildServicePageModelFromService } from "../../lib/build-service-page";
import type { ServicePageModel } from "../../lib/build-service-page";
import { getAllPublishedServiceNodes } from "../../lib/wp-build";

export async function getStaticPaths() {
  const nodesAll = await getAllPublishedServiceNodes();
  const limit = Number(process.env.FAST_BUILD_LIMIT || "0") || 0;
  const nodes = limit > 0 ? nodesAll.slice(0, limit) : nodesAll;
  const out: { params: { slug: string }; props: { model: ServicePageModel } }[] = [];
  for (const node of nodes) {
    const slug = String(node.slug || "").trim();
    if (!slug) continue;
    const model = await buildServicePageModelFromService(node);
    if (model) out.push({ params: { slug }, props: { model } });
  }
  return out;
}

const { model } = Astro.props as { model: ServicePageModel };
---

<BaseLayout title={model.title} description={model.description}>
  <ServiceView {...model} />
</BaseLayout>
