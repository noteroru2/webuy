---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ServiceView } from "../../components/pages/ServiceView";
import { buildServicePageModel } from "../../lib/build-service-page";
import type { ServicePageModel } from "../../lib/build-service-page";
import { getAllServiceSlugs } from "../../lib/wp-build";

export async function getStaticPaths() {
  const slugsAll = await getAllServiceSlugs();
  const limit = Number(process.env.FAST_BUILD_LIMIT || "0") || 0;
  const slugs = limit > 0 ? slugsAll.slice(0, limit) : slugsAll;
  const out: { params: { slug: string }; props: { model: ServicePageModel } }[] = [];
  for (const slug of slugs) {
    const model = await buildServicePageModel(slug);
    if (model) out.push({ params: { slug }, props: { model } });
  }
  return out;
}

const { model } = Astro.props as { model: ServicePageModel };
---

<BaseLayout title={model.title} description={model.description}>
  <ServiceView {...model} />
</BaseLayout>
